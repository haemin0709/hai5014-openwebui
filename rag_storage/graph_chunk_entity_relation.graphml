  <data key="d1">geo</data>
  <data key="d2">The Blue House is a significant Korean landmark, featured as part of the ISS program's cultural exchange activities.</data>
  <data key="d3">chunk-f0e3a26b706037b160f708ed8cd8a076</data>
  <data key="d4">unknown_source</data>
