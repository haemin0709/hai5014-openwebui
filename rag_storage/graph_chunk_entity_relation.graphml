  <data key="d1">organization</data>
  <data key="d2">Woori Bank Sungkyunkwan University Branch handles payments for Korean students and provides banking services for the university.</data>
  <data key="d3">chunk-b62f790fb108b029553fbfebbf5d074b</data>
